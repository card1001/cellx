{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CellX",
  "version": "0.1.0",
  "identifier": "com.card1001.cellx",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CellX",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "card1001",
    "shortDescription": "엑셀 호환 고성능 스프레드시트",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "cellx"
        ],
        "name": "CellX 프로젝트",
        "role": "Editor"
      }
    ],
    "copyright": "© 2026 card1001",
    "longDescription": "Excel과 호환되는 고성능 스프레드시트. 수식·서식·차트·피벗을 xlsx로 그대로 읽고 저장하며, 큰 데이터는 DuckDB로 계산합니다.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "wix": {
        "language": [
          "ko-KR"
        ]
      },
      "nsis": {
        "languages": [
          "Korean"
        ],
        "installMode": "currentUser",
        "startMenuFolder": "CellX",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
